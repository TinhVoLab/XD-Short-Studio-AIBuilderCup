{
  "name": "motion-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "npx --yes concurrently -k \"vite\" \"node --watch-path=server server.js\"",
    "build": "tsc -b && vite build && npm run bundle:remotion",
    "bundle:remotion": "node server/scripts/bundleRemotion.js",
    "postinstall": "remotion browser ensure",
    "preview": "vite preview",
    "backup": "bash gitbackup.sh",
    "deploy": "npm run build && npx --yes firebase-tools deploy",
    "deploy:hosting": "npm run build && npx --yes firebase-tools deploy --only hosting",
    "deploy:functions": "npx --yes firebase-tools deploy --only functions:api",
    "deploy:render-worker": "bash scripts/deploy-render-worker.sh",
    "test:unit": "node tests/unit/run.mjs",
    "test:server": "node tests/runServerTests.mjs",
    "verify": "npm run build && npm run test:unit && npm run test:server",
    "test:layout": "node tests/render/layoutCalibration.mjs",
    "test:widgets": "node tests/render/widgetLayoutAudit.mjs",
    "test:contrast": "node tests/render/widgetContrastAudit.mjs",
    "test:fabric": "node tests/render/fabricParityAudit.mjs",
    "bench:render": "node tests/render/renderBenchmark.mjs",
    "test:api": "node tests/api/test_api.cjs",
    "test:render": "node tests/render/test_render.cjs",
    "test:render:bg": "node tests/render/test_background_render.cjs",
    "test:benchmark": "node tests/benchmark/benchmark.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.14.0",
    "@remotion/bundler": "4.0.512",
    "@remotion/cli": "4.0.512",
    "@remotion/google-fonts": "4.0.512",
    "@remotion/lottie": "4.0.512",
    "@remotion/media-utils": "4.0.512",
    "@remotion/noise": "4.0.512",
    "@remotion/paths": "4.0.512",
    "@remotion/player": "4.0.512",
    "@remotion/renderer": "4.0.512",
    "@remotion/shapes": "4.0.512",
    "@remotion/transitions": "4.0.512",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fabric": "^6.4.3",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.5",
    "mafs": "^0.21.0",
    "mathjs": "^15.2.0",
    "matter-js": "^0.20.0",
    "msedge-tts": "^2.1.0",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.512",
    "smiles-drawer": "^2.4.1",
    "zod": "^4.4.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/matter-js": "^0.20.2",
    "@types/multer": "^2.2.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
