# =========================================================
# XD-Short Render Worker / API container — Google Cloud Run (2nd gen)
#
# Render Worker: deploy với RENDER_WORKER=1 (xem scripts/deploy-render-worker.sh) — Cloud Tasks gọi
# /api/render/internal/run, render ngay trong request (CPU luôn được cấp, tính tiền theo request).
# =========================================================

FROM node:20-bookworm-slim

# Thư viện hệ thống cho chrome-headless-shell của Remotion (không cài Chromium của Debian — Remotion dùng
# bản headless-shell đúng phiên bản, tải sẵn lúc build bên dưới), ffmpeg cho metadata/mix audio, font tiếng Việt.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libnss3 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libgbm1 libasound2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libpango-1.0-0 libcairo2 \
    fonts-noto \
    fonts-noto-color-emoji \
    fonts-liberation \
    ca-certificates \
    fontconfig \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    PORT=8080

WORKDIR /app

# Install package dependencies (include devDeps for Remotion bundling)
COPY package*.json ./
RUN npm ci --include=dev

# Copy project source code
COPY . .

# Pre-bundle Remotion Composition at build time (Zero-Compile at runtime)
RUN npm run bundle:remotion

# Prune development dependencies to keep image slim
RUN npm prune --omit=dev

# Tải sẵn chrome-headless-shell vào image: instance mới render ngay, không tải Chrome lúc khởi động lạnh
RUN node -e "require('@remotion/renderer').ensureBrowser().then(s => console.log('Chrome:', s.path || s.type))"

# Create runtime directories if missing
RUN mkdir -p uploads public/sfx server/projects

EXPOSE 8080

CMD ["node", "server.js"]
